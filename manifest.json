{
  "manifest_version": 3,
  "name": "EnPro - AI Prompt Enhancer",
  "version": "1.0",
  "description": "Enhance AI prompts for better responses",
  "permissions": ["clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
