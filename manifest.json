{
  "manifest_version": 3,
  "name": "EnPro - AI Prompt Enhancer",
  "version": "1.1",
  "description": "Enhance and refine AI prompts for better responses.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
